FROM ros:humble

RUN apt-get update && apt-get install -y \
    ros-humble-navigation2 \
    ros-humble-nav2-bringup \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
# The pure-Python half of g1sim: enough to build the map from a scenario. No mujoco.
COPY g1sim /app/g1sim
COPY scenarios /app/scenarios
COPY send_goal.py generate_map.py nav2_params.yaml /app/

# SCENARIO picks the startup map (and the auto-goal). The map lives in /maps, shared
# with the simulator, which rewrites it and asks map_server to reload it on each reset.
# AUTO_GOAL=0 for the episode runner, which sends its own goals.
ENV SCENARIO=clear
ENV AUTO_GOAL=1
CMD ["/bin/bash", "-c", "source /opt/ros/humble/setup.bash && \
    python3 /app/generate_map.py --scenario /app/scenarios/${SCENARIO}.json --out /maps && \
    ros2 run tf2_ros static_transform_publisher 0 0 0 0 0 0 map odom & \
    ros2 run tf2_ros static_transform_publisher 0 0 0 0 0 0 base_link base_footprint & \
    ros2 run nav2_map_server map_server --ros-args -p yaml_filename:=/maps/map.yaml -p use_sim_time:=False & \
    ros2 run nav2_lifecycle_manager lifecycle_manager --ros-args -r __node:=lifecycle_manager_map -p node_names:=\"['map_server']\" -p autostart:=true -p use_sim_time:=False & \
    ros2 launch nav2_bringup navigation_launch.py use_sim_time:=False use_composition:=False params_file:=/app/nav2_params.yaml & \
    if [ \"${AUTO_GOAL}\" = \"1\" ]; then sleep 15 && python3 /app/send_goal.py $(python3 /app/generate_map.py --scenario /app/scenarios/${SCENARIO}.json --print-goal); fi; \
    wait"]
