FROM ros:humble

WORKDIR /app

# sensor_msgs_py.point_cloud2: PointCloud2 decoding, used by adapter_real_g1.py and
# adapter_isaac_lab.py. action_msgs (GoalStatusArray) ships with ros-base, already here.
RUN apt-get update && apt-get install -y ros-humble-sensor-msgs-py && \
    rm -rf /var/lib/apt/lists/*

COPY sensor_adapter.py vision_mixin.py stuck_detector.py nav2_status_map.py \
     g1_sensors.py g1_real_frame.py \
     adapter_real_g1.py adapter_nav2_common.py adapter_mujoco.py adapter_isaac_lab.py \
     generic_client.py ./

ENV PYTHONUNBUFFERED=1

# --adapter selects the environment at runtime, e.g.:
#   docker run ... ltl-generic-client --adapter real_g1
#   docker run ... ltl-generic-client --adapter mujoco
#   docker run ... ltl-generic-client --adapter isaac_lab
ENTRYPOINT ["/bin/bash", "-c", "source /opt/ros/humble/setup.bash && python3 generic_client.py \"$@\"", "--"]
