% (i) Natural language -> temporal logic
% =====================================================================

% THE CLOSEST PRIOR WORK. Read in full before writing Paper A's intro.
% Grounds every AP into a many-sorted system signature <T,P,C> via a hierarchical
% BERT classifier; reports 95.5% grounded logical equivalence on VLTL-Bench.
% Its limitations section concedes the signature is fixed at inference and that it
% was evaluated on VLTL-Bench only. Neither holds for us: our grounding target is
% the live adapter schema, our check is sound rather than learned, and we run on
% hardware. Fields below confirmed against the PDF.
@article{english2025ginsign,
  title        = {{GinSign}: Grounding Natural Language Into System Signatures for
                  Temporal Logic Translation},
  author       = {English, William and Walker, Chase and Simon, Dominic and
                  Ewetz, Rickard},
  journal      = {arXiv preprint arXiv:2512.16770},
  year         = {2025},
  eprint       = {2512.16770},
  archivePrefix= {arXiv},
  primaryClass = {cs.CL},
  note         = {University of Florida}
}

