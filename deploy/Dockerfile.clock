# The clock: the tick every other service advances on. One container per tier, because
# both tiers need one and because a replay run swaps THIS image and nothing else.
#
# Deliberately the thinnest image in the stack: no adapters, no specs, no /config and no
# /data. The clock reads nothing from disk -- a clock whose behaviour depended on a
# mounted file would be a clock whose tick count depended on deployment.
FROM ros:humble

WORKDIR /app

# std_msgs/String and rclpy are in ros-base, and everything else this service needs
# (http.server, hashlib, struct) is the standard library. The WebSocket stream is ~30
# lines of RFC 6455 framing in clock_node.py rather than a pip dependency in every
# tier's image.
#
# The one package that is not optional: rmw_cyclonedds_cpp. Stock ros:humble ships only
# rmw_fastrtps_cpp, and the robot's own stack runs CycloneDDS -- a tick published on the
# wrong RMW is a tick nothing on that graph advances on. The clock needs it for exactly
# the same reason the evaluator does; see deploy/Dockerfile.evaluator.
RUN apt-get update && apt-get install -y ros-humble-rmw-cyclonedds-cpp && \
    rm -rf /var/lib/apt/lists/*
COPY skill_monitor/ ./skill_monitor/
COPY pyproject.toml ./

ENV PYTHONUNBUFFERED=1 PYTHONPATH=/app:${PYTHONPATH}

# Documentation only -- the compose files run this with network_mode: host, so the port
# is the host's. 8081, because 8080 is the gateway.
#
# The service binds 127.0.0.1 by default and the compose files pass no --host, so under
# network_mode: host it is reachable by the rest of the tier's stack -- the gateway
# proxies /api/clock* -- and by nothing off the box. That default is load-bearing: this
# API has no authentication, and POST /api/clock/mode {"paused": true} stops the tick
# the safety monitor advances on. Publishing it is an explicit --host 0.0.0.0, with
# something in front that terminates TLS and authenticates.
EXPOSE 8081

# --tick-hz/--rate, --mode/--source, --paused, --port, --host. The compose files pass
# the --rate/--source spelling:
#   docker run ... skill-monitor/clock --rate 1.0 --source wall
#   docker run ... skill-monitor/clock --rate 1.0 --source replay --paused
ENTRYPOINT ["/bin/bash", "-c", "source /opt/ros/humble/setup.bash && python3 -m skill_monitor.backend.clock_node \"$@\"", "--"]
