# The test image: the suite's environment, pinned, so a green run stops being a property
# of somebody's laptop.
#
#   docker compose -f deploy/docker-compose.test.yml run --rm tests
#   docker compose -f deploy/docker-compose.test.yml run --rm tests -m pytest -q tests/test_api.py
#
# WHY THIS EXISTS. The suite ran 1217 passed / 4 failed on the Windows machine this was
# written on. All four were `Path.read_text()` with no `encoding=`, which on that host
# resolved to cp1255 -- the Hebrew ANSI codepage -- and died on the UTF-8 em-dashes in
# docs/api.md and skill_monitor/backend/evaluator_node.py. Nothing in the code was
# wrong; the HOST decided the encoding, and the same tree was green on Linux and red
# there.
#
# Those four were fixed rather than papered over -- a container that hides a locale bug
# is worse than no container -- and tests/test_portability.py now refuses a new
# unencoded read, so that bug is closed at the source as well as pinned here. What this
# image is for is the NEXT one, which will not be a locale and will not be predicted:
# an environment nobody chose is an environment nobody can debug, and pinning it turns
# the surprise into a red CI run rather than a person losing a Tuesday.
#
# python:3.10-slim, and NOT ros:humble. Everything under tests/ is pure Python by
# design -- no ROS, no sockets, no hardware, no live LLM -- and tests/ros_stub.py fakes
# the rclpy layer outright, refusing to install if a real rclpy is importable. Pulling
# ~2GB of ROS to run a suite that must not touch ROS would defeat the point twice over:
# once on the download, and once by making it possible for a test to start depending on
# the real thing. 3.10 rather than the 3.13 on the host because pyproject.toml declares
# `requires-python = ">=3.10"` and ros:humble ships 3.10 -- the interpreter that runs
# the tests should be the interpreter that runs the deployed images, so that the floor
# of the supported range is what actually gets exercised.
FROM python:3.10-slim

# node, so that the page's JavaScript is finally checked by something.
#
# skill_monitor/frontend/web.py:page_syntax_problems() shells out to `node --check` and,
# when node is missing, RETURNS a problem string rather than raising -- so its three
# tests in tests/test_web_ui.py call pytest.skip and the suite stays green. Its own
# comment says why the check is there: index.html is one `<script>`, a syntax error
# anywhere in it stops the whole script parsing so every pane blanks at once, that has
# already happened once from a backtick inside an HTML comment inside a template
# literal, and "no test in this repo could see it". Nor could any machine this project
# has run on: node has never been installed on one, so the guard against that failure
# has itself never executed. This container is the first place it does.
#
# --no-install-recommends and the apt lists cleaned in the SAME layer, or the deleted
# lists survive in the layer below and the image carries them anyway.
RUN apt-get update \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# pytest and nothing else, matching [project.optional-dependencies] test in
# pyproject.toml exactly. pyproject.toml deliberately declares no install_requires --
# rclpy and spot come from the ROS environment, and core/ needs neither -- so this one
# line is the whole dependency set. A second line here means either the suite has
# stopped being pure Python or this file has stopped matching the project it tests.
RUN pip install --no-cache-dir pytest

WORKDIR /app

# NO `COPY` OF THE SOURCE, and that is the one way this image deliberately contradicts
# every other Dockerfile in deploy/. Read the header of deploy/docker-compose.dev.yml:
# it argues at length that a deployed image is a self-contained versioned unit, that
# the monitor's spec is whatever that image tag plus that config volume says and there
# is no third source, and it cites sim/docker-compose.sim.yml mounting ../skill_monitor
# over its own COPY as how a broken build went unnoticed for several commits. All of
# that is right, and none of it applies here. A deployed image runs a version; the test
# image runs the WORKING TREE, which by definition is not a version yet. A COPY here
# would mean every edit costs a rebuild, and the bind mount in docker-compose.test.yml
# would then be shadowing a stale copy -- which is precisely the two-source ambiguity
# that header is warning about. Here the mount is the entire mechanism rather than an
# override of one, so there is nothing underneath it to disagree with.
#
# The consequence, stated so nobody "fixes" it: this image is NOT runnable on its own.
# Without the mount /app is empty and `python -m pytest` collects nothing. The compose
# file beside it is how it is invoked.

# PYTHONPATH=/app because there is no `pip install -e .` step -- the source arrives on a
# mount after the build, so nothing can be installed from it at build time, and the
# package is imported straight off the mount.
#
# PYTHONDONTWRITEBYTECODE because /app is a Windows worktree seen through a Linux
# container: without it a run litters the developer's own checkout with __pycache__
# directories full of Linux-CPython-3.10 .pyc files, which the host's 3.13 then has to
# ignore, and which show up in `git status` the day .gitignore slips.
ENV PYTHONPATH=/app \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# ENTRYPOINT is the interpreter, not pytest, because ONE image serves both services in
# docker-compose.test.yml: the suite and the console. argv is appended the way every
# other Dockerfile in deploy/ does it, so the default is the suite and
#
#     run --rm tests -m pytest -q tests/test_api.py
#
# replaces it wholesale -- one file, one -k expression, or
# `-m skill_monitor.frontend.web --check` to syntax-check the page without binding a
# port.
ENTRYPOINT ["python"]
CMD ["-m", "pytest"]
