# The intervention supervisor: subscribes to verdicts and acts on them. No Spot --
# it never builds an automaton, it only reads the monitor's conclusion -- so it is
# the cheap ros:humble image rather than the ~10 min Spot build.
FROM ros:humble

WORKDIR /app

# The OTHER DDS, so this image can be told which wire to speak.
#
# `ros:humble` ships rmw_fastrtps_cpp and only that. The G1's own stack runs CycloneDDS,
# and ROS 2 does not support mixing implementations -- two nodes on one cable with
# different RMWs simply never discover each other, which looks exactly like a broken
# network and is not one. Installing both here costs a few MB and makes
# `RMW_IMPLEMENTATION` a deployment knob instead of a rebuild:
#
#     RMW_IMPLEMENTATION=rmw_cyclonedds_cpp docker compose -f ... up
#
# Match whatever the robot's containers set. `ros2 topic list` seeing nothing while the
# robot is plainly publishing is this, nine times in ten.
RUN apt-get update && apt-get install -y ros-humble-rmw-cyclonedds-cpp && \
    rm -rf /var/lib/apt/lists/*

COPY skill_monitor/ ./skill_monitor/
COPY pyproject.toml ./

ENV PYTHONUNBUFFERED=1 PYTHONPATH=/app:${PYTHONPATH}

# Reads no spec and no descriptor today; /config is declared so that the ladder
# thresholds can move onto the volume without a new image.
ENV SKILL_MONITOR_CONFIG=/config
VOLUME ["/config", "/data"]

ENTRYPOINT ["/bin/bash", "-c", "source /opt/ros/humble/setup.bash && python3 -m skill_monitor.backend.intervention_supervisor \"$@\"", "--"]
