# The monitor engine (Buchi automata + phase machine). Built separately from the
# evaluator because only this image needs Spot, which is a ~10 min source build.
FROM ros:humble

WORKDIR /app

# Spot from source, to avoid C++ ABI conflicts with the ROS packages.
RUN apt-get update && apt-get install -y wget build-essential python3-dev graphviz && \
    wget http://www.lrde.epita.fr/dload/spot/spot-2.12.1.tar.gz && \
    tar -xzf spot-2.12.1.tar.gz && \
    cd spot-2.12.1 && \
    ./configure --prefix=/usr --disable-devel && \
    make -j$(nproc) && \
    make install && \
    cd .. && rm -rf spot-2.12.1* && \
    rm -rf /var/lib/apt/lists/*

# The whole package, not a hand-listed set of files: the previous COPY list had to
# be edited every time a module was added, and a missed one failed at runtime.
# The OTHER DDS, so this image can be told which wire to speak.
#
# `ros:humble` ships rmw_fastrtps_cpp and only that. The G1's own stack runs CycloneDDS,
# and ROS 2 does not support mixing implementations -- two nodes on one cable with
# different RMWs simply never discover each other, which looks exactly like a broken
# network and is not one. Installing both here costs a few MB and makes
# `RMW_IMPLEMENTATION` a deployment knob instead of a rebuild:
#
#     RMW_IMPLEMENTATION=rmw_cyclonedds_cpp docker compose -f ... up
#
# Match whatever the robot's containers set. `ros2 topic list` seeing nothing while the
# robot is plainly publishing is this, nine times in ten.
RUN apt-get update && apt-get install -y ros-humble-rmw-cyclonedds-cpp && \
    rm -rf /var/lib/apt/lists/*

COPY skill_monitor/ ./skill_monitor/
COPY pyproject.toml ./

ENV PYTHONUNBUFFERED=1 PYTHONPATH=/app:${PYTHONPATH}

# Artifacts on a volume, code in the image: a spec changes without a rebuild, and
# the robot can carry one this image never saw. Nothing mounted is still a working
# container -- skill_monitor falls back to the specs COPYed above and says so.
ENV SKILL_MONITOR_CONFIG=/config
VOLUME ["/config", "/data"]

ENTRYPOINT ["/bin/bash", "-c", "source /opt/ros/humble/setup.bash && export PYTHONPATH=/app:/usr/lib/python3.10/site-packages:${PYTHONPATH} && python3 -m skill_monitor.backend.monitor_node \"$@\"", "--"]
